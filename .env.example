# v2 基础设施配置。真实文件必须保持 Git-ignore，Plan 单独由部署管理。
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/niuniu_stock_announcer
DOCUMENT_STORAGE_ROOT=data/documents

# LLM 摘要配置
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
SUMMARY_MAX_FAILURES=3
SUMMARY_RUNNING_TIMEOUT_MINUTES=120
TELEGRAM_RUNNING_TIMEOUT_MINUTES=30

# Telegram 公告与运行日志共用一个 Bot token；Plan 只引用 target URL。
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT=30
TELEGRAM_RUN_LOG_TARGET=
TELEGRAM_RUN_LOG_ATTACH_FILE=true

# 公告 Provider/PDF 的只读请求参数
PROVIDER_TIMEOUT=30
PROVIDER_RETRIES=2
SYNC_SOURCE_DELAY_SECONDS=0.5
PDF_DOWNLOAD_DELAY_SECONDS=0.5-0.8
