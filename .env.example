# PostgreSQL
WATCHLIST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_watchlist_announcer

# Workflow config
WATCHLIST_CONFIG_FILE=config/watchlist.yaml
# 查询起始日为今天向前 WATCHLIST_WINDOW_DAYS 天，结束日固定到明天。
WATCHLIST_WINDOW_DAYS=3
# WATCHLIST_SYNC_SOURCE_DELAY_SECONDS=0.5
PDF_SAVE_DIR=data/pdf
WATCHLIST_PDF_DOWNLOAD_DELAY_SECONDS=0.5-0.8

# LLM summary config
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# 摘要在 retry-failed 阶段累计失败达到该阈值后转为 skipped，跳过 LLM 直发 PDF。
WATCHLIST_SUMMARY_MAX_FAILURES=3
# running 超过阈值会在下一次 workflow 启动时恢复，避免异常退出后永久卡住。
WATCHLIST_SUMMARY_RUNNING_TIMEOUT_MINUTES=120
WATCHLIST_DELIVERY_RUNNING_TIMEOUT_MINUTES=30

# Telegram delivery config
TELEGRAM_TIMEOUT=30
TELEGRAM_A_SHARE_BOT_TOKEN=
TELEGRAM_A_SHARE_TOPIC_URL=https://t.me/c/3954486195/4
TELEGRAM_HK_BOT_TOKEN=
TELEGRAM_HK_TOPIC_URL=https://t.me/c/3954486195/5

# Telegram run log notification config
TELEGRAM_RUN_LOG_ENABLED=false
TELEGRAM_RUN_LOG_BOT_TOKEN=
# 支持 @channel、-100 开头的 chat_id、https://t.me/<channel> 或 topic 链接。
TELEGRAM_RUN_LOG_TARGET=
TELEGRAM_RUN_LOG_ATTACH_FILE=true
