# PostgreSQL
WATCHLIST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_watchlist_announcer

# Workflow config
WATCHLIST_CONFIG_FILE=config/watchlist.yaml
# 查询起始日为今天向前 WATCHLIST_WINDOW_DAYS 天，结束日固定到明天。
WATCHLIST_WINDOW_DAYS=3
# WATCHLIST_SYNC_SOURCE_DELAY_SECONDS=0.5
PDF_SAVE_DIR=data/pdf
WATCHLIST_PDF_DOWNLOAD_DELAY_SECONDS=0.5-0.8

# LLM summary config
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# Telegram delivery config
TELEGRAM_TIMEOUT=30
TELEGRAM_A_SHARE_BOT_TOKEN=
TELEGRAM_A_SHARE_TOPIC_URL=https://t.me/c/3954486195/4
TELEGRAM_HK_BOT_TOKEN=
TELEGRAM_HK_TOPIC_URL=https://t.me/c/3954486195/5
